<?xml version="1.0" encoding="utf-8"?>
<!--
  Hand-authored, covering FBD shapes whose mishandling does not merely drop
  logic but renders the *wrong* logic - worse than an error for a review
  artifact:

    * outVariable negated="true" - dropping the negation renders the exact
      inverse of the deployed program
    * a connector/continuation pair - the named wire CODESYS uses to split a
      network for readability. Mishandled, the upstream network vanished
      entirely and the consumer rendered as a fabricated FALSE assignment.
-->
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <contentHeader name="FidelityFixture">
    <coordinateInfo>
      <fbd><scaling x="1" y="1" /></fbd>
      <ld><scaling x="1" y="1" /></ld>
      <sfc><scaling x="1" y="1" /></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes />
    <pous>
      <pou name="FBD_FIDELITY" pouType="program">
        <interface>
          <inputVars>
            <variable name="xIn">
              <type><BOOL /></type>
            </variable>
          </inputVars>
        </interface>
        <body>
          <FBD>

            <!-- Network 1: a negated output. xInverted := NOT xIn -->
            <inVariable localId="1">
              <position x="0" y="0" />
              <connectionPointOut />
              <expression>xIn</expression>
            </inVariable>
            <outVariable localId="2" negated="true">
              <position x="0" y="0" />
              <connectionPointIn>
                <connection refLocalId="1" />
              </connectionPointIn>
              <expression>xInverted</expression>
            </outVariable>

            <!-- Network 2: an AND feeding a connector, the named wire's source -->
            <inVariable localId="10">
              <position x="0" y="0" />
              <connectionPointOut />
              <expression>xRun</expression>
            </inVariable>
            <inVariable localId="11">
              <position x="0" y="0" />
              <connectionPointOut />
              <expression>xReady</expression>
            </inVariable>
            <block localId="12" typeName="AND">
              <position x="0" y="0" />
              <inputVariables>
                <variable formalParameter="In1">
                  <connectionPointIn><connection refLocalId="10" /></connectionPointIn>
                </variable>
                <variable formalParameter="In2">
                  <connectionPointIn><connection refLocalId="11" /></connectionPointIn>
                </variable>
              </inputVariables>
              <inOutVariables />
              <outputVariables>
                <variable formalParameter="Out1"><connectionPointOut /></variable>
              </outputVariables>
              <addData>
                <data name="http://www.3s-software.com/plcopenxml/fbdcalltype" handleUnknown="implementation">
                  <CallType xmlns="">operator</CallType>
                </data>
              </addData>
            </block>
            <connector name="C1" localId="13">
              <position x="0" y="0" />
              <connectionPointIn>
                <connection refLocalId="12" formalParameter="Out1" />
              </connectionPointIn>
            </connector>

            <!-- Network 3: the continuation re-emits the named wire elsewhere -->
            <continuation name="C1" localId="14">
              <position x="0" y="0" />
              <connectionPointOut />
            </continuation>
            <outVariable localId="15">
              <position x="0" y="0" />
              <connectionPointIn>
                <connection refLocalId="14" />
              </connectionPointIn>
              <expression>xBoth</expression>
            </outVariable>

          </FBD>
        </body>
      </pou>
    </pous>
  </types>
</project>
